#. Plugin Name of the plugin
#: invoqk.php
msgid "Invoqk E-Rechnung QA"
msgstr "Invoqk E-Rechnung QA"

#. Description of the plugin
#: invoqk.php
msgid "Finds and checks the e-invoice of every WooCommerce order. Not legal or tax advice."
msgstr "Findet und prüft die E-Rechnung jeder WooCommerce-Bestellung. Keine Rechts- oder Steuerberatung."

